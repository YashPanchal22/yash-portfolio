# ---------------------------------------------------------------
# Copy to `.env.local` (never commit that file) and adjust.
# Everything here is optional — the site builds with no env at all.
# ---------------------------------------------------------------

# Optional: contact form delivery.
# Paste the POST endpoint from Formspree / Basin / Getform / your own API.
# Leave empty to fall back to the prefilled-mail-draft flow.
VITE_CONTACT_FORM_ENDPOINT=""

# Optional: the public URL the site will be served from.
# Used only to generate sitemap.xml + robots.txt during `npm run build`.
# Example: https://yashpanchal22.github.io/portfolio
VITE_SITE_URL=""

# Optional: sub-path for GitHub Pages project sites ("/portfolio/", "/repo/").
# Leave empty (or "/") when deploying to a domain root (Netlify, Vercel, custom domain).
VITE_BASE_PATH=""
